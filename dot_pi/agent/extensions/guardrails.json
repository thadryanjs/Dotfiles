{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.1/schema.json",
  "applyBuiltinDefaults": true,
  "version": "0.17.1",
  "onboarding": {
    "completed": true,
    "completedAt": "2026-08-24T21:39:24.971Z",
    "version": "0.17.1"
  },
  "features": {
    "pathAccess": true
  },
  "pathAccess": {
    "mode": "ask",
    "allowedPaths": [
      {
        "kind": "file",
        "path": "/dev/null"
      }
    ]
  },
  "policies": {
    "rules": [
      {
        "id": "example-secret-env-files",
        "name": "Secret env files",
        "description": "Block .env files and variants",
        "patterns": [
          { "pattern": ".env" },
          { "pattern": ".env.*" }
        ],
        "allowedPatterns": [
          { "pattern": ".env.example" },
          { "pattern": "*.sample.env" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "enabled": true
      },
      {
        "id": "example-log-files",
        "name": "Log files",
        "description": "Treat log files as read-only",
        "patterns": [
          { "pattern": "*.log" },
          { "pattern": "*.out" }
        ],
        "protection": "readOnly",
        "onlyIfExists": true,
        "enabled": true
      },
      {
        "id": "example-ssh-keys",
        "name": "SSH keys",
        "description": "Block SSH private key files",
        "patterns": [
          { "pattern": "*.pem" },
          { "pattern": "*_rsa" },
          { "pattern": "*_ed25519" }
        ],
        "allowedPatterns": [
          { "pattern": "*.pub" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "enabled": true
      },
      {
        "id": "example-aws-credentials",
        "name": "AWS credentials",
        "description": "Block AWS credentials and config files",
        "patterns": [
          { "pattern": ".aws/credentials" },
          { "pattern": ".aws/config" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "enabled": true
      },
      {
        "id": "example-database-files",
        "name": "Database files",
        "description": "Protect database files from modification",
        "patterns": [
          { "pattern": "*.db" },
          { "pattern": "*.sqlite" },
          { "pattern": "*.sqlite3" }
        ],
        "protection": "readOnly",
        "onlyIfExists": true,
        "enabled": true
      },
      {
        "id": "ssh-config-dir",
        "name": "SSH config directory",
        "description": "Protect ~/.ssh from modification",
        "patterns": [
          { "pattern": ".ssh/*" },
          { "pattern": ".ssh/config" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "enabled": true
      },
      {
        "id": "gnupg-dir",
        "name": "GnuPG directory",
        "description": "Protect ~/.gnupg keys",
        "patterns": [
          { "pattern": ".gnupg/*" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "enabled": true
      }
    ]
  },
  "permissionGate": {
    "autoDenyPatterns": [
      {
        "pattern": "\\bgit\\s+(rm|mv|push|pull|fetch|merge|rebase|reset|revert|checkout|switch|restore|branch|tag|stash|clean|cherry-pick|apply|am|clone|init|remote|config|gc|prune|reflog|filter-branch|update-ref|worktree|submodule|sparse-checkout)\\b",
        "description": "Git state-changing command (except add/commit) — agent may not run these",
        "regex": true
      },
      {
        "pattern": "\\b(curl|wget)\\b[^|]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b",
        "description": "Pipe-to-shell (curl|wget ... | sh) — remote code execution",
        "regex": true
      },
      {
        "pattern": "rm\\s+.*\\.git",
        "description": "Prevent deletion of .git directory",
        "regex": true
      },
      {
        "pattern": "\\bch(mod|own)\\s+(-[a-zA-Z]*R[a-zA-Z]*|--recursive)\\b",
        "description": "Recursive chmod/chown — can wreck a whole tree",
        "regex": true
      }
    ]
  }
}
