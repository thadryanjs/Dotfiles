{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.1/schema.json",
  "features": {
    "permissionGate": true
  },
  "pathAccess": {
    "allowedPaths": [
      {
        "kind": "directory",
        "path": "~/.config/nvim/lua/plugins"
      },
      {
        "kind": "directory",
        "path": "/mnt/Workspace"
      }
    ]
  },
  "permissionGate": {
    "requireConfirmation": true,
    "patterns": [
      {
        "pattern": "rm ",
        "description": "Deleting files"
      }
    ]
  },
  "version": "0.17.1"
}
