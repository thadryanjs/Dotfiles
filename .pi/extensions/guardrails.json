{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.22.0/schema.json",
  "features": {
    "permissionGate": true
  },
  "pathAccess": {
    "allowedPaths": [
      {
        "kind": "directory",
        "path": "~/.config/nvim/lua/plugins"
      },
      {
        "kind": "directory",
        "path": "/mnt/Workspace"
      },
      {
        "kind": "file",
        "path": "~/Vaults"
      },
      {
        "kind": "directory",
        "path": "~/Vaults/Projects/Work/Primary/TheoryProject/MergedAlgo"
      }
    ]
  },
  "permissionGate": {
    "requireConfirmation": true,
    "patterns": [
      {
        "pattern": "rm ",
        "description": "Deleting files"
      }
    ]
  },
  "version": "0.19.0"
}
